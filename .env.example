# Copie para .env (nunca versione o .env)

# Sienge
SIENGE_SUBDOMAIN=sencoeng
SIENGE_API_USER=
SIENGE_API_PASSWORD=
# Dry-run é o padrão: só "false", explícito, faz chamadas reais (produção)
SIENGE_DRY_RUN=true
# Pacote contratado
SIENGE_DAILY_QUOTA=100

# Cota (ADR-0009): requisições do dia guardadas para ações de pessoas; lançamentos e rotinas param antes (provisório)
COTA_RESERVA_PESSOAS=10
# Dia das rotinas automáticas que chamam o Sienge (0 = domingo)
ROTINAS_DIA_SEMANA=0

# Conferência de notas: margem, em dias, em cada ponta do período de busca (provisório)
CONFERENCIA_MARGEM_DIAS=3

# Consulta de títulos: intervalo mínimo, em minutos, entre dois "Atualizar agora"
ATUALIZAR_TITULOS_INTERVALO_MIN=5

# Banco (o Docker Compose local usa estes dados)
DATABASE_URL=postgres://despesas:despesas@localhost:5432/despesas

# Storage temporário dos anexos (ADR-0006)
STORAGE_PATH=./.storage

# API
API_PORT=3000
API_HOST=127.0.0.1
# Base dos links enviados por e-mail
APP_URL=http://localhost:5173

# Dados pessoais: chave AES-256-GCM (32 bytes em base64) para cifrar CPF e chave Pix
# Gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DADOS_CHAVE_CIFRA=

# E-mail pelo SMTP da Locaweb (ADR-0007). Vazio em desenvolvimento: o link de redefinição vai para o log.
# Caixa de e-mail hospedada na Locaweb: SMTP_HOST=email-ssl.com.br e SMTP_PORT=465 (SSL/TLS).
# SMTP_USER e SMTP_FROM são o mesmo endereço (ex.: naoresponda@sencoengenharia.com.br); SMTP_PASSWORD é a senha dessa caixa.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Consulta pública de CNPJ
CNPJ_API_URL=https://brasilapi.com.br/api/cnpj/v1
