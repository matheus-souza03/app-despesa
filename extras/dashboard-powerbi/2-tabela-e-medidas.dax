// ============================================================
// Tabela de datas — Modelagem > Nova tabela, cole e confirme.
// Depois: Ferramentas de tabela > Marcar como tabela de datas (coluna Date)
// e ligue Calendario[Date] a Pagamentos[Data do pagamento] (Exibição de modelo).
// ============================================================
Calendario =
VAR Inicio = DATE ( YEAR ( MIN ( Pagamentos[Data do pagamento] ) ), 1, 1 )
VAR Fim = DATE ( YEAR ( MAX ( Pagamentos[Data do pagamento] ) ), 12, 31 )
RETURN
    ADDCOLUMNS (
        CALENDAR ( Inicio, Fim ),
        "Ano", YEAR ( [Date] ),
        "Mês", FORMAT ( [Date], "mmm/yy" ),
        "Mês ordem", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
    )
// Na coluna Mês: Ferramentas de coluna > Classificar por coluna > Mês ordem.

// ============================================================
// Medidas — selecione a tabela Pagamentos > Nova medida, uma por vez.
// ============================================================
Total gasto = SUM ( Pagamentos[Valor pago] )

Títulos pagos = DISTINCTCOUNT ( Pagamentos[Título] )

Média por título = DIVIDE ( [Total gasto], [Títulos pagos] )

Gasto no mês anterior =
CALCULATE ( [Total gasto], DATEADD ( Calendario[Date], -1, MONTH ) )

Variação no mês =
DIVIDE ( [Total gasto] - [Gasto no mês anterior], [Gasto no mês anterior] )

Participação no total =
DIVIDE ( [Total gasto], CALCULATE ( [Total gasto], ALLSELECTED ( Pagamentos[Centro de custo] ) ) )
